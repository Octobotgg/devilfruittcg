# DevilFruit local environment template
# Copy this file to `.env.local` and fill only the sections you need.

# Core app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres / pricing
# Preferred primary Postgres connection string.
DATABASE_URL=
# Optional alias used by some scripts when DATABASE_URL is not set.
SUPABASE_DB_URL=
# Required for live JustTCG imports and incremental refreshes.
JUSTTCG_API_KEY=

# Supabase auth / cloud-backed user data
NEXT_PUBLIC_CLOUD_PROVIDER=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_KEY=

# Optional marketplace integrations
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_VERIFICATION_TOKEN=

# Optional background jobs / sync secrets
CRON_SECRET=
MATCH_INTEL_SNAPSHOT_BASE_URL=
MATCH_INTEL_SYNC_URL=http://localhost:3000
MATCH_INTEL_SYNC_KEY=
MATCH_INTEL_INGEST_KEY=

# Optional Firebase client configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
